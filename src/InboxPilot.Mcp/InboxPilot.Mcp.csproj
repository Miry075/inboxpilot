<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>InboxPilot.Mcp</RootNamespace>
    <AssemblyName>InboxPilot.Mcp</AssemblyName>
  </PropertyGroup>

  <!-- Floating versions for the first restore; pin them (dotnet list package) once it builds. -->
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.*" />
    <PackageReference Include="Google.Apis.Gmail.v1" Version="1.*" />
    <PackageReference Include="Microsoft.Graph" Version="5.*" />
    <!-- Transitive dependency of Microsoft.Graph. Pinned to the patched release for GHSA-7j59-v9qr-6fq9
         (RedirectHandler forwards Cookie/custom headers on cross-host redirects). Remove once Graph depends on >= 1.22.0. -->
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="1.22.0" />
    <PackageReference Include="Azure.Identity" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InboxPilot.Tests" />
  </ItemGroup>

</Project>
