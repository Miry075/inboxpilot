# InboxPilot server parameters.
# Copy to %LOCALAPPDATA%\InboxPilot\inboxpilot.env (Windows) or ~/.local/share/InboxPilot/inboxpilot.env
# run-triage passes these to the MCP server as environment variables. Never commit the real file.
# Full list: InboxPilot.Mcp.exe params

INBOXPILOT_OUTLOOK_CLIENT_ID=00000000-0000-0000-0000-000000000000
# INBOXPILOT_GMAIL_CLIENT_SECRET=client_secret.json
# INBOXPILOT_GMAIL_ENABLED=true
# INBOXPILOT_OUTLOOK_ENABLED=true

INBOXPILOT_NOTIFY_CHANNEL=whatsapp
INBOXPILOT_NOTIFY_DAILY_CAP=10

INBOXPILOT_WHATSAPP_TOKEN=EAAG...
INBOXPILOT_WHATSAPP_PHONE_NUMBER_ID=1234567890
INBOXPILOT_WHATSAPP_TO=32470000000
INBOXPILOT_WHATSAPP_TEMPLATE=inboxpilot_alert
INBOXPILOT_WHATSAPP_TEMPLATE_LANGUAGE=en

# INBOXPILOT_TELEGRAM_BOT_TOKEN=123456789:AA...
# INBOXPILOT_TELEGRAM_CHAT_ID=123456789
